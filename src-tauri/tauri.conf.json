{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BhayanakShare",
  "version": "0.1.0",
  "identifier": "dev.bhayanakshare.share",
  "build": {
    "beforeDevCommand": "pnpm --filter ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BhayanakShare",
        "visible": false,
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["bhayanakshare"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzREIwRkM2RjVBNzI3MzMKUldReko2ZjF4Zy9iNCthSUVya0hSZzllTlBXM01UbGdmVGJuKzlSMzk0bmJMSjZTajY3dmxqWGcK",
      "endpoints": ["https://github.com/theHimanshuShekhar/bhayanakshare/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Himanshu Shekhar",
    "copyright": "Copyright (c) 2026 Himanshu Shekhar",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/theHimanshuShekhar/bhayanakshare",
    "category": "Utility",
    "shortDescription": "Send files directly from one device to another.",
    "longDescription": "BhayanakShare sends files and text directly from one device to another over a peer-to-peer connection, AirDrop-style, with no account and no server holding your files.",
    "linux": {
      "deb": { "desktopTemplate": "linux/bhayanakshare.desktop" },
      "rpm": { "desktopTemplate": "linux/bhayanakshare.desktop" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
